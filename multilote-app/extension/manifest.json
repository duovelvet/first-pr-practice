{
  "manifest_version": 3,
  "name": "MultiLote",
  "version": "0.4.0",
  "description": "Sincroniza tu cola de MultiLote con Wallapop, Vinted, Milanuncios y Todocolección.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.wallapop.com/*",
    "https://*.vinted.es/*",
    "https://*.milanuncios.com/*",
    "https://*.todocoleccion.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MultiLote",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wallapop.com/*",
        "https://*.vinted.es/*",
        "https://*.milanuncios.com/*",
        "https://*.todocoleccion.net/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.wallapop.com/*",
        "https://*.vinted.es/*",
        "https://*.milanuncios.com/*",
        "https://*.todocoleccion.net/*"
      ],
      "js": [
        "lib/bridge.js",
        "lib/dom.js",
        "lib/api-plan.js",
        "lib/profiles.js",
        "adapters/_registry.js",
        "adapters/wallapop.js",
        "adapters/vinted.js",
        "adapters/milanuncios.js",
        "adapters/todocoleccion.js",
        "content.js",
        "lib/recorder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
