{
  "manifest_version": 3,
  "name": "MultiLote",
  "version": "0.2.0",
  "description": "Sincroniza tu cola de MultiLote con Wallapop, Vinted y Milanuncios.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.wallapop.com/*",
    "https://*.vinted.es/*",
    "https://*.milanuncios.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MultiLote",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wallapop.com/*", "https://*.vinted.es/*", "https://*.milanuncios.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
